# Conservative set: real bugs and cheap performance wins, nothing stylistic.
# Run with: clang-tidy -p build <file>   (build/compile_commands.json is generated by meson)
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-use-nullptr,
  modernize-use-override,
  readability-container-size-empty,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -performance-avoid-endl
HeaderFilterRegex: '^(core|plugins|cli|zmd|sdk)/'
WarningsAsErrors: ''
